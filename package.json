{
  "name": "football-stories-101",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Football Stories 101: one researched football story a day, by email first and on the web a week later.",
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate.ts",
    "prebuild": "npm run validate && npm run images",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "publish:daily": "tsx scripts/publish.ts",
    "check": "astro check",
    "images": "tsx scripts/images.ts",
    "illustrate": "tsx scripts/illustrate-ai.ts",
    "social": "tsx scripts/social-pack.ts",
    "photos": "tsx scripts/commons-hero.ts",
    "references": "tsx scripts/fetch-references.ts",
    "candidates": "tsx scripts/search-references.ts",
    "colourise": "tsx scripts/colourise-references.ts",
    "touchup": "tsx scripts/touch-up.ts",
    "painttest": "tsx scripts/paint-test.ts",
    "paint": "tsx scripts/paint-gpt.ts",
    "post-social": "tsx scripts/post-social.ts",
    "check-facebook": "tsx scripts/check-facebook-post.ts",
    "publish-painting": "tsx scripts/publish-painting.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
