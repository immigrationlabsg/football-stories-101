---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublishedStories } from '../lib/stories';
import { formatDate } from '../lib/format';
import { storyNumber } from '../schema/story';
import { site } from '../site.config';
import { withBase, paths } from '../lib/url';

const corrections = (await getCollection('corrections')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const stories = await getPublishedStories();
const bySlug = new Map(stories.map((s) => [s.data.slug, s]));
---

<Base title="Corrections" description="A dated log of every correction made to a published story." path={paths.corrections()}>
  <div class="narrow">
    <p class="eyebrow">Corrections</p>
    <h1>Corrections log</h1>
    <p class="intro">
      When a published story turns out to be wrong, the web version is corrected and the change is recorded here with the
      date. Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> if you spot an error.
    </p>
    {
      corrections.length === 0 ? (
        <p class="panel">No corrections have been needed yet.</p>
      ) : (
        <ol class="log">
          {corrections.map((c) => {
            const story = c.data.story ? bySlug.get(c.data.story) : undefined;
            return (
              <li>
                <time datetime={c.data.date.toISOString()}>{formatDate(c.data.date)}</time>
                {story && (
                  <a href={withBase(paths.story(story.data.slug))}>
                    {storyNumber(story.data.number)} · {story.data.title}
                  </a>
                )}
                <p>{c.data.text}</p>
              </li>
            );
          })}
        </ol>
      )
    }
  </div>
</Base>

<style>
  .intro {
    font-family: var(--serif);
    color: var(--ink-soft);
  }
  .log {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .log li {
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }
  .log time {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-mute);
  }
  .log a {
    font-weight: 600;
  }
  .log p {
    margin: 0.4rem 0 0;
    font-family: var(--serif);
  }
</style>
