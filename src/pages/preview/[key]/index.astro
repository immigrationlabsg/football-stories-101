---
import Base from '../../../layouts/Base.astro';
import HeroImage from '../../../components/HeroImage.astro';
import { getAllStories, storyStatus, storyWords, storyTitleParts } from '../../../lib/stories';
import { storyNumber } from '../../../schema/story';
import { withBase } from '../../../lib/url';
import { site, PREVIEW_KEY } from '../../../site.config';

export function getStaticPaths() {
  return [{ params: { key: PREVIEW_KEY } }];
}
const stories = await getAllStories();
---

<Base title="Editor's preview" description="Unlisted preview of every story." noindex>
  <div class="wrap">
    <p class="eyebrow">Editor's preview · unlisted</p>
    <h1>Every story, drafts included</h1>
    <p class="meta">
      {stories.length} stories. Read them exactly as subscribers will. This page is not linked from the site and is hidden
      from search engines; anyone with the address can open it.
    </p>
    <ol class="list">
      {
        stories.map((s) => {
          const { subject, angle } = storyTitleParts(s);
          return (
            <li>
              <a href={withBase(`/preview/${PREVIEW_KEY}/${s.data.slug}/`)}>
                <HeroImage number={s.data.number} src={s.data.hero.src} alt="" sizes="96px" />
                <span class="text">
                  <span class="eyebrow">
                    {storyNumber(s.data.number)} · {site.pillars[s.data.pillar].label}
                  </span>
                  <strong>{subject}</strong> / {angle}
                  <span class="status">{storyStatus(s)} · {storyWords(s).toLocaleString('en-GB')} words</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.6rem;
  }
  .list a {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 0.9rem;
    align-items: center;
    padding: 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    font-family: var(--serif);
  }
  .list a:hover {
    border-color: var(--accent);
  }
  .list :global(img) {
    width: 84px;
    height: 84px;
    object-fit: cover;
    border-radius: 6px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .text .eyebrow {
    margin: 0;
  }
  .status {
    font: 0.8rem var(--sans);
    color: var(--ink-mute);
  }
</style>
