---
import Base from '../layouts/Base.astro';
import { getPublishedStories, storyTitleParts } from '../lib/stories';
import { storyNumber } from '../schema/story';
import { site } from '../site.config';
import { withBase, paths } from '../lib/url';

const latest = (await getPublishedStories()).slice(0, 3);
const links = [
  { href: withBase(paths.subscribe()), label: 'Subscribe to the daily email', primary: true },
  site.social.telegram ? { href: site.social.telegram, label: 'Telegram channel (no email needed)' } : null,
  { href: withBase(paths.allStories()), label: 'All stories by number' },
  { href: withBase(paths.archive()), label: 'Archive by month' },
  { href: withBase(paths.about()), label: 'About and editorial standards' },
  site.social.facebook ? { href: site.social.facebook, label: 'Facebook' } : null,
  site.social.threads ? { href: site.social.threads, label: 'Threads' } : null,
].filter(Boolean) as { href: string; label: string; primary?: boolean }[];
---

<Base title="Links" description={`${site.name} on the web: subscribe, the latest stories and where else to follow.`} path={paths.links()}>
  <div class="links-page">
    <p class="eyebrow">{site.name}</p>
    <h1>Links</h1>
    <p class="meta">{site.tagline}</p>

    {
      latest.length > 0 && (
        <section>
          <p class="eyebrow">Latest stories</p>
          <ul class="stack">
            {latest.map((s) => (
              <li>
                <a class="link-card" href={withBase(paths.story(s.data.slug))}>
                  <span class="num">{storyNumber(s.data.number)}</span>
                  <span>
                    <strong>{storyTitleParts(s).subject}</strong> / {storyTitleParts(s).angle}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section>
      <p class="eyebrow">Everything else</p>
      <ul class="stack">
        {
          links.map((l) => (
            <li>
              <a class:list={['link-card', { primary: l.primary }]} href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .links-page {
    width: min(100% - 2 * var(--space), 34rem);
    margin-inline: auto;
    text-align: center;
  }
  .links-page section {
    margin-top: 2rem;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .link-card {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    align-items: baseline;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    text-align: left;
    box-shadow: var(--shadow);
  }
  .link-card:hover {
    border-color: var(--accent);
  }
  .link-card.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    font-family: var(--sans);
    font-weight: 600;
    justify-content: center;
  }
  .num {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
</style>
